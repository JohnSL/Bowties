{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(.specify/scripts/powershell/*)",
      "Bash(.specify/scripts/bash/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.github/hooks/enrichment-gate.ps1\" -Format claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
